* {
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #1e1e2f;
}

QLabel {
    color: #ffffff;
}

QPushButton {
    background-color: #3a3a5a;
    color: white;
    border: none;
    padding: 10px;
    border-radius: 6px;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #4f4f7a;
}

QPushButton:pressed {
    background-color: #2d2d44;
}

QComboBox {
    background-color: #2d2d44;
    color: white;
    padding: 5px;
    border-radius: 4px;
    min-height: 24px;
    border: 1px solid #3a3a5a;
    padding-left: 8px;
}

QTabWidget::pane {
    border: 1px solid #3a3a5a;
    background-color: #29293d;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #2d2d44;
    color: white;
    padding: 10px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin: 2px;
}

QTabBar::tab:selected {
    background-color: #3a3a5a;
}